# Copy to .env and fill in the key. Never commit .env.

# Ollama Cloud (https://ollama.com/settings/keys). The cloud exposes an
# OpenAI-compatible API at /v1; a local Ollama server would use
# http://localhost:11434/v1 and accept any non-empty key.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
# DeepSeek 4.1 Flash: 1M context, good tool calling, strong agentic benchmarks.
# Alternatives: glm-5.3-flash (faster/cheaper) or gpt-oss:120b (older).
OLLAMA_MODEL=deepseek-v4.1-flash:1017

# "responses": POST /v1/responses in stateless mode; the full message history
# is sent on every request. Reasoning items (encrypted_content) are included
# and replayed on later turns. "chat_completions": classic endpoint.
AGENT_API_MODE=responses

# Retrieval. Ollama Cloud does not serve embedding models, so the index is
# built locally with bge-m3 on the first run (about 2 GB download).
AGENT_EMBEDDING_MODEL=BAAI/bge-m3
AGENT_TOP_K=5
AGENT_BATCH_SIZE=32
# Embeddings run on CPU by default; set AGENT_DEVICE=cuda to use the GPU.
AGENT_DEVICE=cpu
# AGENT_CORPUS_DIR=data/corpus
# AGENT_INDEX_DIR=data/index

# Persistent embedding server, enabled by default. Run `make embed-up` before
# ask/chat/search. If it is set and not reachable, those commands fail at
# startup. Comment it out to load bge-m3 locally instead.
AGENT_EMBED_SERVER=http://127.0.0.1:8765
# EMBED_BIND=127.0.0.1
# EMBED_PORT=8765

# Optional local tracing. Uncomment after `make langfuse-up`.
# Leave the keys commented to disable tracing.
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PROJECT_ID=local-project
# LANGFUSE_TRACING_ENABLED=false
